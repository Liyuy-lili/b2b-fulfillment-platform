+<script setup lang="ts">
+import {
+  FileJobApi,
+  WarehouseApi,
+  savePrivateBlob,
+  type FileJob,
+  type JobRow,
+  type JobAudit,
+  type Dataset,
+  type WarehouseScope
+} from '@/api/erp/fulfillment/jobs'
+import { checkPermi } from '@/utils/permission'
+import { useWindowSize } from '@vueuse/core'
