+  } catch {
+    error.value = '本次导入提交未确认完成，请检查错误提示后用相同内容重试。'
+  } finally {
+    working.value = ''
+  }
+}
+async function submitExport() {
+  if (working.value) return
+  working.value = 'export'
+  error.value = ''
+  exportKey.value ||= crypto.randomUUID()
