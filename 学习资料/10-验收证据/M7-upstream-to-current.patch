+        assertThrows(IllegalArgumentException.class,()->new OrderQuantities(BigDecimal.ZERO,BigDecimal.ZERO,BigDecimal.ZERO,BigDecimal.ZERO,BigDecimal.ZERO,BigDecimal.ZERO));
+    }
+}
