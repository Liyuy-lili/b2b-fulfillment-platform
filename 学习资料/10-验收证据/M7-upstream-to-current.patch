+  if (!selected.value || reviewing.value || !note.value.trim()) return
+  reviewing.value = true
+  reviewError.value = ''
+  reviewKey.value ||= crypto.randomUUID()
+  try {
+    await ReconcileApi.review(selected.value.id, note.value.trim(), reviewKey.value)
